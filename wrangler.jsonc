{
  "$schema": "node_modules/wrangler/config-schema.json",
  // entry próprio: reexporta o fetch do OpenNext e acrescenta o `scheduled`
  "main": "worker.js",
  "name": "lunor-dev",
  // Sincronização de deploy: onboarding #29 publicado na main.
  // Mantém variáveis Text cadastradas no dashboard entre os deploys do Wrangler.
  "keep_vars": true,
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Workers AI fica disponível no runtime como env.AI. Não exige API key
  // dentro do Worker e toda inferência do LUNOR passa pela camada src/lib/ai.
  "ai": {
    "binding": "AI"
  },
  // O build OpenNext é executado uma única vez pelo Workers Builds
  // antes do comando de deploy configurado no painel do Cloudflare.
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "lunor-dev"
    }
  ],
  // Ambiente compartilhado de desenvolvimento. O domínio próprio será
  // configurado somente quando houver um ambiente de produção separado.
  "workers_dev": true,
  // Horários do cron em UTC (São Paulo = UTC-3):
  // 12:00 UTC = 09:00: lembretes operacionais existentes.
  // 22:00 UTC sexta = 19:00: preparação espiritual do fim de semana.
  // 22:00 UTC sábado = 19:00: lembrete de quem serve no domingo.
  // 23:00 UTC diário = 20:00: lembrete um dia antes dos demais serviços.
  // Sem CRON_SECRET os handlers encerram com 404.
  "triggers": {
    "crons": ["0 12 * * *", "0 22 * * 5", "0 22 * * 6", "0 23 * * *"]
  },
  "observability": {
    "enabled": true
  }
}
