{
  "$schema": "node_modules/wrangler/config-schema.json",
  // entry próprio: reexporta o fetch do OpenNext e acrescenta o `scheduled`
  "main": "worker.js",
  "name": "lunor-dev",
  // Mantém variáveis Text cadastradas no dashboard entre os deploys do Wrangler.
  "keep_vars": true,
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "lunor-dev"
    }
  ],
  // Ambiente compartilhado de desenvolvimento. O domínio próprio será
  // configurado somente quando houver um ambiente de produção separado.
  "workers_dev": true,
  // 12:00 UTC = 09:00 em Brasília. Sem CRON_SECRET configurado, o handler
  // encerra com 404 e não consulta o Supabase.
  "triggers": {
    "crons": ["0 12 * * *"]
  },
  "observability": {
    "enabled": true
  }
}
