{
  "$schema": "node_modules/wrangler/config-schema.json",
  // entry próprio: reexporta o fetch do OpenNext e acrescenta o `scheduled`
  "main": "worker.js",
  "name": "lunor-dev",
  // Sincronização de deploy: onboarding #29 publicado na main.
  // Mantém variáveis Text cadastradas no dashboard entre os deploys do Wrangler.
  "keep_vars": true,
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Workers AI fica disponível no runtime como env.AI. Não exige API key
  // dentro do Worker e toda inferência do LUNOR passa pela camada src/lib/ai.
  "ai": {
    "binding": "AI"
  },
  // Workers Builds usa `wrangler versions upload` nos previews. Antes de o
  // Wrangler empacotar o Worker, precisamos gerar `.open-next/worker.js` e
  // `.open-next/assets` com o adaptador oficial do OpenNext.
  "build": {
    "command": "npx opennextjs-cloudflare build"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "lunor-dev"
    }
  ],
  // Ambiente compartilhado de desenvolvimento. O domínio próprio será
  // configurado somente quando houver um ambiente de produção separado.
  "workers_dev": true,
  // 12:00 UTC = 09:00 em Brasília: lembretes operacionais da véspera.
  // 22:00 UTC de sexta = 19:00 em Brasília: preparação espiritual de quem
  // serve no fim de semana. Sem CRON_SECRET o handler encerra com 404.
  "triggers": {
    "crons": ["0 12 * * *", "0 22 * * 5"]
  },
  "observability": {
    "enabled": true
  }
}
