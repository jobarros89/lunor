# Supabase hospedado usado pelo frontend
# Nunca coloque service_role em variáveis NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Web Push
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@exemplo.com

# Autentica o Cron Trigger interno do Cloudflare Worker.
CRON_SECRET=

# YouTube Data API v3 (somente no servidor; nunca use NEXT_PUBLIC_)
YOUTUBE_API_KEY=

# OAuth da conta oficial do YouTube
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
# Opcional; por padrão usa https://SEU_DOMINIO/api/integrations/youtube/callback
YOUTUBE_OAUTH_REDIRECT_URI=

# Chave AES-256 em base64/base64url para cifrar tokens OAuth no banco
INTEGRATIONS_ENCRYPTION_KEY=
