# Supabase hospedado usado pelo frontend
# Nunca coloque service_role em variáveis NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Necessária para webhooks/integracões confiáveis.
SUPABASE_SERVICE_ROLE_KEY=

# Resend — e-mail transacional (server-only; nunca use NEXT_PUBLIC_)
RESEND_API_KEY=
NEXT_PUBLIC_APP_URL=

# Web Push
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Autentica o Cron Trigger interno do Cloudflare Worker.
CRON_SECRET=

# YouTube Data API v3 (somente no servidor; nunca use NEXT_PUBLIC_)
YOUTUBE_API_KEY=

# OAuth da conta oficial do YouTube
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REDIRECT_URI=

# Chave AES-256 em base64/base64url para cifrar tokens OAuth no banco
INTEGRATIONS_ENCRYPTION_KEY=

# Provider ativo
WHATSAPP_PROVIDER=

# WhatsApp Business Platform — Meta Cloud API oficial (server-only)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_TEMPLATE_ASSIGNMENT=
WHATSAPP_TEMPLATE_REMINDER=

# Evolution API — piloto self-hosted (server-only)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
# A instância NÃO fica em env: ela é vinculada à igreja em whatsapp_connections.
EVOLUTION_WEBHOOK_SECRET=

# API bíblica do versículo diário (opcional)
BIBLE_API_BASE_URL=
BIBLE_API_TOKEN=
